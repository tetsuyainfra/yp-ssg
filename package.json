    "dev:11ty": "eleventy --serve",
    "serve": "serve ./_site",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format:check": "prettier --check --ignore-path .gitignore './**/*.{js,ts,json,css}'",
    "format:fix": "prettier --write --ignore-path .gitignore './**/*.{js,ts,json,css}'",
    "clean": "rimraf _site"
  },
