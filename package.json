    "autoprefixer": "^10.4.21",
    "env-cmd": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "prettier": "3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "serve": "^14.2.4",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
