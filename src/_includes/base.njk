<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="keywords" content="PeerCast yellow-page YP Developper" />
    <meta name="description" content="開発向けYP" />
    <title>
      {%- if title %}
        {{ title }}
      {%- else %}
        {{ metadata.title }}
      {%- endif %}
    </title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description"
          content="{%- if description -%} {{ description }} {%- else -%} {{ metadata.description }} {%- endif -%}" />

    <link href="/style.css" rel="stylesheet" />
    <script src="/bundle.js"></script>

    {% block header_block %}
      {{ header_scripts | safe }}
    {% endblock header_block %}
  </head>
  <body {{ bodyAttrs | safe }}>

    {% block nav %}
    <nav>
      <ul>
        {%- for item in nav.items %}
          <li>
            <a href="{{ item.url }}"
              class="hover:text-sky-400">
              {{ item.title }}
            </a>
          </li>
        {%- endfor %}
      </ul>
    </nav>
    {% endblock nav %}

    {% block content %}
      {{ content | safe }}
    {% endblock content %}
  </body>
</html>
{% set js %}
  {% include "main.js" %}
{% endset %}
<script>{{ js | safe }}</script>
